{
  "name": "strapi",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "node --env-file=../.env ../node_modules/@strapi/strapi/bin/strapi.js build",
    "console": "node --env-file=../.env ../node_modules/@strapi/strapi/bin/strapi.js console",
    "deploy": "strapi deploy",
    "dev": "node --env-file=../.env ../node_modules/@strapi/strapi/bin/strapi.js develop",
    "develop": "node --env-file=../.env ../node_modules/@strapi/strapi/bin/strapi.js develop",
    "start": "node --env-file=../.env ../node_modules/@strapi/strapi/bin/strapi.js start",
    "strapi": "node --env-file=../.env ../node_modules/@strapi/strapi/bin/strapi.js",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry",
    "seed": "node --env-file=../.env scripts/seed.cjs",
    "token": "node --env-file=../.env scripts/token.cjs",
    "test": "vitest run",
    "test:api": "node --env-file=../.env ../node_modules/vitest/vitest.mjs run --config vitest.api.config.ts"
  },
  "dependencies": {
    "@strapi/database": "5.59.0",
    "@strapi/plugin-cloud": "5.59.0",
    "@strapi/plugin-users-permissions": "5.59.0",
    "@strapi/strapi": "5.59.0",
    "pg": "8.20.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "21f75fa0-6fda-47ce-8fe5-30d2f925415d",
    "installId": "91bb290fb5869b9cd5f1664e0ee4c30e421285b9fa7dbf17de73a232833d4e58"
  }
