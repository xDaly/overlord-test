{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog post",
    "description": "Billet de blog publié par un membre"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 10,
      "maxLength": 120
    },
    "content": {
      "type": "text",
      "required": true,
      "minLength": 60,
      "maxLength": 20000
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "blogPosts"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category"
    },
    "views": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "required": true
    },
    "usefulBase": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "required": true
    },
    "usefulBy": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "inversedBy": "usefulBlogPosts"
    },
    "comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-comment.blog-comment",
      "mappedBy": "post"
    }
  }
}
